# Required for `support-agent run`. `support-agent search` needs nothing.
ANTHROPIC_API_KEY=sk-ant-...

# Required only if a stage is routed to the OpenAI provider.
# OPENAI_API_KEY=sk-...

# Which provider every stage runs on, with that provider's default model.
# SUPPORT_AGENT_PROVIDER=openai

# The default model for every stage. A bare id belongs to the provider above;
# `provider:model` switches provider at the same time.
# SUPPORT_AGENT_MODEL=claude-opus-5

# One stage only, one variable per stage: classify, draft, critique, clarify, handoff.
# This is the multi-model case - cheap triage on one provider, the judgement calls on
# another. A key is needed for every provider a route touches.
# SUPPORT_AGENT_MODEL_CLASSIFY=openai:gpt-5-mini
# SUPPORT_AGENT_MODEL_CRITIQUE=anthropic:claude-opus-5
